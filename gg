const picker=document.getElementById('picker'), mixBtn=document.getElementById('mixBtn'), mixResult=document.getElementById('mixResult'), orb1=document.getElementById('orb1'), orb2=document.getElementById('orb2');
let selected=[];
function pairKey(a,b){return [a,b].sort().join('+')}
function stateAr(state){return state==='gas'?'غاز':state==='liquid'?'سائل':'صلب'}
function getElementStyle(symbol){return gameElementStyles[symbol]||{state:'solid',color:'#8feff6'}}
function renderMatter(state){
  if(state==='gas')return `<div class="matter gas"><span class="gas-bubble b1"></span><span class="gas-bubble b2"></span><span class="gas-bubble b3"></span><span class="gas-bubble b4"></span></div>`;
  if(state==='liquid')return `<div class="matter liquid"><span class="liquid-wave"></span></div>`;
  return `<div class="matter solid"></div>`;
}
function orbMarkup(el){
  if(!el) return '?';
  const style=getElementStyle(el.symbol);
  return `<div class="orb-core state-${style.state}" style="--orb-color:${style.color}">${renderMatter(style.state)}<div class="orb-symbol">${el.symbol}</div><div class="orb-name">${el.ar}</div><div class="orb-state">${stateAr(style.state)}</div></div>`;
}
function updateOrbs(){
  const left=selected[0]||null,right=selected[1]||null;
  orb1.classList.toggle('empty',!left);
  orb2.classList.toggle('empty',!right);
  orb1.innerHTML=orbMarkup(left);
  orb2.innerHTML=orbMarkup(right);
}
function renderPicker(){
  picker.innerHTML='';
  gameSymbols.forEach(sym=>{
    const el=elements.find(e=>e.symbol===sym);
    const style=getElementStyle(sym);
    const b=document.createElement('button');
    b.className='pick';
    b.style.setProperty('--pick-color',style.color);
    b.innerHTML=`<span class="pick-symbol">${el.symbol}</span><strong>${el.ar}</strong><small>${el.en}</small><span class="pick-state">${stateAr(style.state)}</span>`;
    b.addEventListener('click',()=>selectGameElement(el,b));
    picker.appendChild(b);
  });
}
function selectGameElement(el,button){
  if(selected.find(x=>x.symbol===el.symbol)){
    selected=selected.filter(x=>x.symbol!==el.symbol);
    button.classList.remove('selected');
  }else{
    if(selected.length>=2)return;
    selected.push(el);
    button.classList.add('selected');
  }
  updateOrbs();
  mixBtn.disabled=selected.length!==2;
  mixResult.innerHTML=selected.length===2?'جاهز للتفاعل! اضغط <b>ادمج العنصرين</b> لمشاهدة الناتج.':'اختر عنصرين لبدء التجربة.';
}
mixBtn.addEventListener('click',()=>{
  const r=recipes[pairKey(selected[0].symbol,selected[1].symbol)];
  mixResult.innerHTML=r
    ? `<strong style="font-size:1.12rem">${r.name} — ${r.formula}</strong><br>${r.note}`
    : `<strong>لا توجد وصفة مبسطة محفوظة لهذا الزوج.</strong><br>في الكيمياء الحقيقية، إمكانية التفاعل والمنتجات تعتمد على النسب والحرارة والضغط وحالة المواد.`;
});
document.getElementById('resetMix').addEventListener('click',()=>{
  selected=[];
  updateOrbs();
  mixBtn.disabled=true;
  mixResult.textContent='اختر عنصرين لبدء التجربة.';
  document.querySelectorAll('.pick').forEach(b=>b.classList.remove('selected'));
});
renderPicker();
updateOrbs();


const quiz=[
 {q:'ما الجسيم الذي يحمل شحنة سالبة داخل الذرة؟',a:['البروتون','النيوترون','الإلكترون','النواة'],c:2},
 {q:'العدد الذري للعنصر يساوي عدد ماذا في نواته؟',a:['البروتونات','النيوترونات فقط','الإلكترونات والنيوترونات معًا','مستويات الطاقة'],c:0},
 {q:'أي مجموعة في الجدول الدوري تُعرف بالغازات النبيلة؟',a:['المجموعة 1','المجموعة 2','المجموعة 17','المجموعة 18'],c:3},
 {q:'أي رمز كيميائي يمثل عنصر الصوديوم؟',a:['S','So','Na','N'],c:2},
 {q:'الرابطة الناتجة غالبًا عن انتقال إلكترونات من فلز إلى لافلز هي:',a:['تساهمية','أيونية','هيدروجينية','فلزية فقط'],c:1},
 {q:'أي مما يلي يُعد مركبًا؟',a:['O₂','Fe','H₂O','Ne'],c:2},
 {q:'العناصر الموجودة في المجموعة نفسها تتشابه غالبًا في:',a:['عدد مستويات الطاقة فقط','الخواص الكيميائية وعدد إلكترونات التكافؤ','الكتلة الذرية نفسها','عدد النيوترونات'],c:1},
 {q:'أي عنصر رمزه Cl؟',a:['الكالسيوم','الكربون','الكلور','الكوبالت'],c:2}
];
let qi=0,score=0,locked=false;const qTitle=document.getElementById('qTitle'),answers=document.getElementById('answers'),qCount=document.getElementById('qCount'),liveScore=document.getElementById('liveScore'),progressBar=document.getElementById('progressBar'),nextQ=document.getElementById('nextQ');
function renderQuestion(){locked=false;nextQ.disabled=true;const item=quiz[qi];qCount.textContent=`السؤال ${qi+1} من ${quiz.length}`;liveScore.textContent=`${score} نقطة`;progressBar.style.width=`${(qi/quiz.length)*100}%`;qTitle.textContent=item.q;answers.innerHTML='';item.a.forEach((txt,i)=>{const b=document.createElement('button');b.className='answer';b.textContent=txt;b.addEventListener('click',()=>answerQuestion(i,b));answers.appendChild(b);});nextQ.textContent=qi===quiz.length-1?'عرض النتيجة':'السؤال التالي'}
function answerQuestion(i,b){if(locked)return;locked=true;const correct=quiz[qi].c;if(i===correct){score++;b.classList.add('correct')}else{b.classList.add('wrong');answers.children[correct].classList.add('correct')}liveScore.textContent=`${score} نقطة`;nextQ.disabled=false}
nextQ.addEventListener('click',()=>{if(qi<quiz.length-1){qi++;renderQuestion()}else{progressBar.style.width='100%';document.getElementById('quizCard').style.display='none';document.getElementById('scoreBox').style.display='grid';document.getElementById('finalScore').textContent=`${score}/${quiz.length}`;const pct=score/quiz.length;document.getElementById('scoreText').textContent=pct>=.875?'ممتاز! فهمك للمفاهيم الأساسية قوي جدًا.':pct>=.625?'جيد جدًا. راجع بعض المفاهيم وستصل لدرجة أعلى بسهولة.':'بداية جيدة. راجع أساسيات الذرة والجدول الدوري والروابط ثم جرّب مرة أخرى.'}});
document.getElementById('restartQuiz').addEventListener('click',()=>{qi=0;score=0;document.getElementById('scoreBox').style.display='none';document.getElementById('quizCard').style.display='block';renderQuestion()});
renderQuestion();
</script>
