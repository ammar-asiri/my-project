<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>مختبر العناصر — الجدول الدوري التفاعلي</title>

<style>
:root{
  --bg:#08114f;
  --bg2:#171e86;
  --bg3:#0f2ca0;
  --panel:rgba(20,31,125,.58);
  --panel2:rgba(16,53,170,.36);
  --line:rgba(132,238,255,.22);
  --text:#f6fdff;
  --muted:#bfeefd;
  --accent:#66f0f2;
  --accent2:#24b7ff;
  --violet:#7b4dff;
  --glow:0 0 26px rgba(102,240,242,.35);
  --radius:22px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-height:100vh;font-family:"Segoe UI",Tahoma,Arial,sans-serif;color:var(--text);background:
 radial-gradient(circle at 16% 0%,rgba(102,240,242,.10),transparent 28%),
 radial-gradient(circle at 100% 15%,rgba(123,77,255,.16),transparent 32%),
 linear-gradient(145deg,var(--bg),var(--bg2) 55%,var(--bg3));overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(to bottom,black,transparent 80%)}
.wrap{width:min(1500px,96vw);margin:auto;padding:26px 0 48px}
header{display:flex;gap:18px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:22px}
.brand{display:flex;gap:12px;align-items:center}
.logo{width:48px;height:48px;border-radius:16px;display:grid;place-items:center;font-weight:900;font-size:22px;background:linear-gradient(145deg,#1f9bff,#6af0ef 62%,#a775ff);box-shadow:0 0 24px rgba(102,240,242,.35),0 0 42px rgba(123,77,255,.18)}
h1{margin:0;font-size:clamp(1.5rem,2.8vw,2.6rem)}
.sub{color:var(--muted);margin-top:5px;font-size:.95rem}
nav{display:flex;gap:8px;flex-wrap:wrap;background:rgba(255,255,255,.045);padding:7px;border:1px solid var(--line);border-radius:18px;backdrop-filter:blur(14px)}
button{font:inherit}
.nav-btn,.ghost-btn,.primary-btn{border:0;cursor:pointer;color:#fff;border-radius:13px;padding:10px 15px;transition:.25s ease}
.nav-btn{background:transparent}
.nav-btn:hover,.nav-btn.active{background:linear-gradient(135deg,rgba(31,155,255,.92),rgba(106,240,239,.68));box-shadow:var(--glow);color:#051544}
.page{display:none}
.page.active{display:block;animation:fade .35s ease}
@keyframes fade{from{opacity:.25;transform:translateY(6px)}to{opacity:1;transform:none}}
.hero{padding:18px 20px;border-radius:var(--radius);border:1px solid var(--line);background:linear-gradient(135deg,rgba(22,181,212,.13),rgba(77,87,255,.16));backdrop-filter:blur(16px);margin-bottom:18px;box-shadow:inset 0 1px 0 rgba(255,255,255,.05)}
.hero h2{margin:0 0 8px;font-size:1.35rem}
.hero p{margin:0;color:var(--muted);line-height:1.8}
.table-shell{direction:ltr;overflow-x:auto;padding:14px 10px 18px;border-radius:var(--radius);border:1px solid var(--line);background:rgba(8,20,88,.64);backdrop-filter:blur(18px);box-shadow:inset 0 1px 0 rgba(255,255,255,.03)}
.periodic-grid{display:grid;grid-template-columns:repeat(18,minmax(58px,1fr));grid-template-rows:repeat(10,72px);gap:7px;min-width:1180px;position:relative}
.element{position:relative;border:1px solid rgba(190,241,255,.18);border-radius:13px;padding:7px 6px;background:linear-gradient(155deg,rgba(37,52,154,.86),rgba(7,19,74,.92));color:#fff;text-align:left;cursor:pointer;overflow:hidden;isolation:isolate;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease,filter .18s ease}
.element:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 25% 10%,rgba(255,255,255,.18),transparent 38%);z-index:-1}
.element:hover,.element:focus-visible{z-index:8;transform:scale(1.14);border-color:rgba(170,252,255,.9);box-shadow:0 0 14px rgba(81,220,255,.85),0 0 34px rgba(123,77,255,.4),inset 0 0 18px rgba(106,240,239,.16);outline:none;filter:saturate(1.18)}
.z{font-size:.68rem;opacity:.76}
.symbol{font-size:1.38rem;font-weight:900;line-height:1.05;margin-top:1px}
.ename{font-size:.58rem;opacity:.82;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nonmetal{background:linear-gradient(155deg,rgba(67,79,196,.90),rgba(13,28,94,.95))}
.noble{background:linear-gradient(155deg,rgba(82,103,230,.92),rgba(24,39,118,.96))}
.alkali{background:linear-gradient(155deg,rgba(94,71,208,.92),rgba(29,20,97,.95))}
.alkaline{background:linear-gradient(155deg,rgba(59,116,214,.92),rgba(16,40,118,.95))}
.halogen{background:linear-gradient(155deg,rgba(41,168,197,.95),rgba(11,60,110,.96))}
.transition{background:linear-gradient(155deg,rgba(51,89,181,.92),rgba(14,35,92,.95))}
.post{background:linear-gradient(155deg,rgba(33,135,194,.92),rgba(10,51,102,.95))}
.metalloid{background:linear-gradient(155deg,rgba(92,122,211,.92),rgba(22,45,103,.95))}
.lanthanide{background:linear-gradient(155deg,rgba(62,153,198,.93),rgba(11,68,108,.95))}
.actinide{background:linear-gradient(155deg,rgba(103,90,212,.93),rgba(29,30,108,.95))}
.placeholder{display:grid;place-items:center;border:1px dashed rgba(146,240,255,.35);border-radius:12px;color:#bfeefd;font-size:.72rem;background:rgba(102,240,242,.06)}
.series-label{display:flex;align-items:center;justify-content:flex-end;padding-inline:8px;color:#bfeefd;font-size:.72rem;direction:rtl}
.info-card{margin-top:18px;min-height:155px;border:1px solid rgba(146,240,255,.24);border-radius:var(--radius);padding:20px;background:linear-gradient(135deg,rgba(17,82,160,.55),rgba(8,24,83,.76));backdrop-filter:blur(20px);box-shadow:0 18px 60px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.04);display:grid;grid-template-columns:110px 1fr;gap:18px;align-items:center;transition:.2s ease}
.info-atom{width:96px;height:96px;border-radius:24px;display:grid;place-items:center;background:linear-gradient(145deg,#22b5ff,#6cf0ef 60%,#8260ff);box-shadow:0 0 32px rgba(102,240,242,.28);font-size:2rem;font-weight:900;color:#04184f}
.info-card h3{margin:0 0 8px;font-size:1.4rem}
.meta{display:flex;gap:10px;flex-wrap:wrap;margin:8px 0 11px}
.pill{padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid var(--line);font-size:.84rem}
.fact{color:#e4fbff;line-height:1.75;margin:0}
.legend{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 0;color:#d5fbff;font-size:.78rem}
.legend span{padding:5px 9px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.04)}
.game-grid,.quiz-shell{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.panel{border:1px solid var(--line);border-radius:var(--radius);background:var(--panel);backdrop-filter:blur(18px);padding:20px;box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}
.panel h3{margin-top:0}
.element-picker{display:grid;grid-template-columns:repeat(auto-fit,minmax(92px,1fr));gap:10px}
.pick{padding:12px 10px;border-radius:16px;border:1px solid var(--line);background:rgba(255,255,255,.05);color:#fff;cursor:pointer;transition:.2s;display:flex;flex-direction:column;gap:8px;align-items:center;justify-content:center;min-height:92px;text-align:center}
.pick:hover,.pick.selected{transform:translateY(-2px) scale(1.02);background:linear-gradient(135deg,rgba(24,130,255,.45),rgba(106,240,239,.18));box-shadow:0 0 22px rgba(102,240,242,.15)}
.pick-symbol{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;font-weight:900;color:#07205a;background:radial-gradient(circle at 35% 35%,rgba(255,255,255,.95),var(--pick-color,#74eaf5));box-shadow:0 0 14px color-mix(in srgb, var(--pick-color,#74eaf5) 45%, transparent)}
.pick small{color:var(--muted)}
.pick-state{font-size:.68rem;padding:3px 8px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12)}
.mix-zone{min-height:260px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.015))}
.mix-icons{display:flex;align-items:center;gap:14px;margin:16px 0;flex-wrap:wrap;justify-content:center}
.mix-orb{width:132px;height:132px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(166,242,255,.25);background:radial-gradient(circle at 30% 25%,rgba(255,255,255,.12),rgba(255,255,255,.04) 35%,rgba(2,15,65,.68));box-shadow:inset 0 0 18px rgba(255,255,255,.08),0 0 28px rgba(98,236,246,.12);padding:10px;overflow:hidden;position:relative}
.mix-orb.empty{font-size:2rem;color:#d4f8ff;opacity:.75}
.orb-core{width:100%;height:100%;border-radius:50%;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(circle at 35% 28%,rgba(255,255,255,.28),color-mix(in srgb, var(--orb-color,#7cecff) 80%, #fff) 26%, color-mix(in srgb, var(--orb-color,#7cecff) 58%, #14215f) 63%, #0a1448 100%);box-shadow:0 0 24px color-mix(in srgb, var(--orb-color,#7cecff) 34%, transparent),inset 0 0 18px rgba(255,255,255,.16)}
.orb-core::after{content:"";position:absolute;inset:10px;border-radius:50%;border:1px solid rgba(255,255,255,.08)}
.orb-symbol{position:relative;z-index:2;font-size:1.9rem;font-weight:900;text-shadow:0 0 12px rgba(255,255,255,.25)}
.orb-name{position:absolute;bottom:28px;right:0;left:0;font-size:.78rem;font-weight:700;z-index:2}
.orb-state{position:absolute;bottom:10px;right:50%;transform:translateX(50%);font-size:.68rem;padding:3px 8px;border-radius:999px;background:rgba(3,14,48,.42);backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.11);z-index:2}
.matter{position:absolute;inset:0;z-index:1}
.gas-bubble,.solid-piece,.liquid-wave{position:absolute;display:block}
.gas-bubble{border-radius:50%;background:rgba(255,255,255,.24);border:1px solid rgba(255,255,255,.32);backdrop-filter:blur(1px)}
.gas-bubble.b1{width:20px;height:20px;top:24px;right:24px}
.gas-bubble.b2{width:12px;height:12px;bottom:34px;left:26px}
.gas-bubble.b3{width:14px;height:14px;top:52px;left:34px}
.gas-bubble.b4{width:10px;height:10px;bottom:24px;right:34px}
.matter.gas::before,.matter.gas::after{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.18)}
.matter.gas::before{width:58px;height:58px;top:16px;left:18px;filter:blur(10px)}
.matter.gas::after{width:42px;height:42px;bottom:18px;right:18px;filter:blur(8px)}
.matter.liquid::before{content:"";position:absolute;left:14px;right:14px;bottom:18px;height:52px;border-radius:50% 50% 42% 42%/26% 26% 50% 50%;background:linear-gradient(180deg,rgba(255,255,255,.22),color-mix(in srgb, var(--orb-color,#7cecff) 90%, #fff) 40%,color-mix(in srgb, var(--orb-color,#7cecff) 70%, #0f1a55));box-shadow:0 -6px 14px rgba(255,255,255,.1) inset}
.matter.liquid::after{content:"";position:absolute;left:28px;right:28px;bottom:56px;height:10px;border-radius:999px;background:rgba(255,255,255,.28);filter:blur(.3px)}
.liquid-wave{left:18px;right:18px;bottom:58px;height:8px;border-radius:999px;background:rgba(255,255,255,.22)}
.matter.solid::before{content:"";position:absolute;width:60px;height:60px;left:36px;top:26px;border-radius:16px;background:linear-gradient(145deg,rgba(255,255,255,.42),color-mix(in srgb, var(--orb-color,#7cecff) 92%, #fff) 42%, color-mix(in srgb, var(--orb-color,#7cecff) 64%, #12205d));transform:rotate(16deg);box-shadow:0 8px 18px rgba(0,0,0,.16)}
.matter.solid::after{content:"";position:absolute;width:24px;height:24px;right:24px;bottom:28px;border-radius:8px;background:rgba(255,255,255,.26);transform:rotate(-16deg)}
.plus{font-size:1.8rem;color:#8bf4f6;text-shadow:0 0 16px rgba(102,240,242,.45)}
.primary-btn{background:linear-gradient(135deg,#109dfb,#6af0ef);box-shadow:0 10px 30px rgba(31,157,251,.22);color:#062058}
.primary-btn:disabled{opacity:.4;cursor:not-allowed}
.ghost-btn{background:rgba(255,255,255,.06);border:1px solid var(--line)}
.result{margin-top:15px;padding:14px;border-radius:15px;background:rgba(255,255,255,.05);border:1px solid var(--line);line-height:1.7;width:100%}
.result b{color:#90fbff}
.quiz-card{grid-column:1/-1}
.qtitle{font-size:1.16rem;line-height:1.7;margin-bottom:14px}
.answers{display:grid;gap:10px}
.answer{width:100%;text-align:right;padding:12px 14px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.045);color:#fff;cursor:pointer;transition:.2s}
.answer:hover{background:rgba(106,240,239,.12)}
.answer.correct{border-color:#a7f3d0;background:rgba(16,185,129,.15)}
.answer.wrong{border-color:#fda4af;background:rgba(244,63,94,.14)}
.quiz-top{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:14px}
.progress{height:9px;background:rgba(255,255,255,.07);border-radius:999px;overflow:hidden;flex:1}
.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,#109dfb,#6af0ef);transition:.3s}
.scorebox{text-align:center;min-height:260px;display:grid;place-items:center}
.bigscore{font-size:3rem;font-weight:900;text-shadow:0 0 24px rgba(102,240,242,.45)}
footer{text-align:center;color:#c8f6ff;font-size:.82rem;padding-top:22px}
@media(max-width:800px){.game-grid,.quiz-shell{grid-template-columns:1fr}.info-card{grid-template-columns:1fr;text-align:center}.info-atom{margin:auto}.meta{justify-content:center}header{align-items:flex-start}.mix-orb{width:118px;height:118px}.mix-icons{gap:10px}}


/* ===== تحسينات الهواتف والأجهزة اللوحية ===== */
.mobile-table-hint{display:none;margin:0 0 10px;color:#bffaff;font-size:.82rem;text-align:center;padding:8px 12px;border:1px solid rgba(132,238,255,.18);border-radius:12px;background:rgba(255,255,255,.04)}

@media (max-width: 1024px){
  .wrap{width:min(100%,96vw);padding-top:18px}
  header{gap:14px}
  .periodic-grid{min-width:1040px;grid-template-columns:repeat(18,minmax(50px,1fr));grid-template-rows:repeat(10,66px);gap:6px}
  .symbol{font-size:1.22rem}
  .element{padding:6px 5px}
}

@media (max-width: 700px){
  body{background:linear-gradient(160deg,#07104b,#161f87 56%,#0d2b99)}
  .wrap{width:100%;padding:12px 12px calc(28px + env(safe-area-inset-bottom));}
  header{display:block;margin-bottom:14px}
  .brand{justify-content:center;text-align:center;margin-bottom:12px}
  .logo{width:44px;height:44px;border-radius:14px;flex:0 0 44px}
  h1{font-size:1.5rem}
  .sub{font-size:.8rem;line-height:1.5}
  nav{width:100%;display:grid;grid-template-columns:repeat(3,1fr);gap:5px;padding:5px;border-radius:14px}
  .nav-btn{padding:9px 5px;font-size:.78rem;white-space:nowrap;border-radius:10px}
  .hero{padding:14px 15px;border-radius:17px;margin-bottom:12px}
  .hero h2{font-size:1.08rem;line-height:1.5}
  .hero p{font-size:.84rem;line-height:1.7}
  .mobile-table-hint{display:block}
  .table-shell{border-radius:16px;padding:8px 4px 12px;margin-inline:-2px;scrollbar-width:thin;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;scroll-snap-type:x proximity}
  .periodic-grid{min-width:970px;grid-template-columns:repeat(18,48px);grid-template-rows:repeat(10,61px);gap:5px;padding-inline:3px}
  .element{border-radius:10px;padding:5px 4px;touch-action:manipulation}
  .element:hover,.element:focus-visible{transform:scale(1.08)}
  .z{font-size:.58rem}
  .symbol{font-size:1.08rem}
  .ename{font-size:.48rem}
  .placeholder,.series-label{font-size:.62rem}
  .legend{gap:6px;margin-top:10px;justify-content:center}
  .legend span{font-size:.67rem;padding:4px 7px}
  .info-card{margin-top:12px;min-height:auto;padding:16px;border-radius:17px;grid-template-columns:72px 1fr;gap:12px;text-align:right}
  .info-atom{width:68px;height:68px;border-radius:18px;font-size:1.55rem;margin:0}
  .info-card h3{font-size:1.1rem;margin-bottom:6px}
  .meta{gap:6px;margin:6px 0 8px;justify-content:flex-start}
  .pill{font-size:.7rem;padding:5px 7px}
  .fact{font-size:.82rem;line-height:1.65}

  .game-grid,.quiz-shell{grid-template-columns:1fr;gap:12px}
  .panel{padding:14px;border-radius:17px}
  .panel h3{font-size:1rem;margin-bottom:12px}
  .element-picker{grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
  .pick{min-height:86px;padding:8px 5px;border-radius:13px;gap:5px}
  .pick-symbol{width:34px;height:34px;font-size:.9rem}
  .pick strong{font-size:.78rem}
  .pick small{font-size:.66rem;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .pick-state{font-size:.61rem;padding:2px 6px}
  .mix-zone{min-height:auto;padding-block:18px}
  .mix-icons{gap:9px;margin:10px 0 14px;flex-wrap:nowrap}
  .mix-orb{width:108px;height:108px;padding:7px}
  .orb-symbol{font-size:1.55rem}
  .orb-name{font-size:.68rem;bottom:24px}
  .orb-state{font-size:.58rem;bottom:7px;padding:2px 6px}
  .plus{font-size:1.45rem}
  .primary-btn,.ghost-btn{width:100%;padding:11px 12px}
  .result{font-size:.82rem;padding:11px;margin-top:10px}

  .quiz-top{display:grid;grid-template-columns:auto 1fr auto;gap:7px;font-size:.72rem}
  .qtitle{font-size:1rem;line-height:1.65;margin-bottom:10px}
  .answer{font-size:.88rem;padding:11px 12px;border-radius:12px}
  .bigscore{font-size:2.4rem}
  footer{font-size:.7rem;padding:18px 8px 0}
}

@media (max-width: 390px){
  .wrap{padding-inline:8px}
  .brand{gap:8px}
  .logo{width:40px;height:40px;flex-basis:40px}
  h1{font-size:1.32rem}
  .sub{font-size:.72rem}
  .nav-btn{font-size:.7rem;padding:8px 3px}
  .periodic-grid{min-width:936px;grid-template-columns:repeat(18,46px);grid-template-rows:repeat(10,59px);gap:5px}
  .info-card{grid-template-columns:60px 1fr;padding:13px;gap:10px}
  .info-atom{width:58px;height:58px;font-size:1.35rem}
  .info-card h3{font-size:1rem}
  .fact{font-size:.76rem}
  .element-picker{grid-template-columns:repeat(2,minmax(0,1fr))}
  .mix-orb{width:94px;height:94px}
  .orb-symbol{font-size:1.35rem}
  .orb-name{font-size:.62rem}
  .orb-state{font-size:.54rem}
}

</style>

</head>
<body>
<div class="wrap">
<header>
  <div class="brand"><div class="logo">⚛</div><div><h1>مختبر العناصر</h1><div class="sub">جدول دوري تفاعلي • لعبة دمج • اختبارات كيمياء</div></div></div>
  <nav aria-label="التنقل الرئيسي">
    <button class="nav-btn active" data-page="periodic">الجدول الدوري</button>
    <button class="nav-btn" data-page="game">لعبة الدمج</button>
    <button class="nav-btn" data-page="quiz">اختبارات قصيرة</button>
  </nav>
</header>

<main>
<section id="periodic" class="page active">
  <div class="hero"><h2>الجدول الدوري التفاعلي للعناصر</h2><p>مرّر المؤشر فوق أي عنصر لعرض اسمه، رمزه، عدده الذري، كتلته الذرية وأصل تسميته. تم توزيع العناصر على شبكة من 18 عمودًا بما يحاكي مواقع الجدول الدوري القياسية.</p></div>
  <div class="mobile-table-hint">↔ اسحب الجدول أفقيًا لمشاهدة جميع العناصر</div>
  <div class="table-shell"><div id="periodicGrid" class="periodic-grid" aria-label="الجدول الدوري"></div></div>
  <div class="legend"><span>فلزات قلوية</span><span>فلزات قلوية ترابية</span><span>فلزات انتقالية</span><span>أشباه فلزات</span><span>هالوجينات</span><span>غازات نبيلة</span><span>لانثانيدات</span><span>أكتينيدات</span></div>
  <div id="infoCard" class="info-card" aria-live="polite">
    <div class="info-atom">⚛</div><div><h3>اكتشف العناصر</h3><p class="fact">مرّر سهم الفأرة فوق أي عنصر في الجدول، وستظهر معلوماته هنا فورًا.</p></div>
  </div>
