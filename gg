const grid = document.getElementById('periodicGrid');
const infoCard = document.getElementById('infoCard');
const defaultInfo = `<div class="info-atom">⚛</div><div><h3>اكتشف العناصر</h3><p class="fact">مرّر سهم الفأرة فوق أي عنصر في الجدول، وستظهر معلوماته هنا فورًا.</p></div>`;

function renderPeriodicTable(){
  grid.innerHTML = '';
  const ph1=document.createElement('div'); ph1.className='placeholder'; ph1.textContent='57–71'; ph1.style.gridRow='6'; ph1.style.gridColumn='3'; grid.appendChild(ph1);
  const ph2=document.createElement('div'); ph2.className='placeholder'; ph2.textContent='89–103'; ph2.style.gridRow='7'; ph2.style.gridColumn='3'; grid.appendChild(ph2);
  const l1=document.createElement('div'); l1.className='series-label'; l1.textContent='اللانثانيدات ←'; l1.style.gridRow='9'; l1.style.gridColumn='1 / span 2'; grid.appendChild(l1);
  const l2=document.createElement('div'); l2.className='series-label'; l2.textContent='الأكتينيدات ←'; l2.style.gridRow='10'; l2.style.gridColumn='1 / span 2'; grid.appendChild(l2);
  elements.forEach(el=>{
    const card=document.createElement('button');
    card.type='button'; card.className=`element ${el.category}`;
    card.style.gridRow=el.row; card.style.gridColumn=el.col;
    card.setAttribute('aria-label',`${el.ar} ${el.en}`);
    card.innerHTML=`<div class="z">${el.z}</div><div class="symbol">${el.symbol}</div><div class="ename">${el.en}</div>`;
    const show=()=>showInfo(el); const hide=()=>{infoCard.innerHTML=defaultInfo;};
    card.addEventListener('mouseenter',show); card.addEventListener('mouseleave',hide); card.addEventListener('focus',show); card.addEventListener('blur',hide);
    grid.appendChild(card);
  });
}
function showInfo(el){
  infoCard.innerHTML=`<div class="info-atom">${el.symbol}</div><div><h3>${el.ar} <span style="color:#9bf5ff;font-weight:600">${el.en}</span></h3><div class="meta"><span class="pill">الرمز: ${el.symbol}</span><span class="pill">العدد الذري: ${el.z}</span><span class="pill">الوزن الذري: ${el.mass}</span></div><p class="fact"><strong>أصل التسمية:</strong> ${el.origin}</p></div>`;
}
renderPeriodicTable();

